# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
MAULT_CONTROLLER_TOKEN=replace-with-a-random-token-at-least-32-characters
# Exact browser origin(s), separated by commas. No paths or trailing slashes.
MAULT_ALLOWED_ORIGINS=https://mault.xyz
# Default: local TLS reverse proxy. See README for LAN development and TLS options.
MAULT_BIND=127.0.0.1
MAULT_PORT=8765
# MAULT_TLS_CERT=/etc/mault/tls/fullchain.pem
# MAULT_TLS_KEY=/etc/mault/tls/privkey.pem
