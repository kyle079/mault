{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "magic-vault",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-13",
  "observability": { "enabled": true },
  "build": { "command": "pnpm run build:web" },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "containers": [
    {
      "class_name": "MagicVaultApi",
      "image": "../../Dockerfile.server",
      "image_build_context": "../..",
      "instance_type": "standard-2",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "API", "class_name": "MagicVaultApi" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MagicVaultApi"] }],
  "vars": {
    "AUTH_PROVIDER": "neon",
    "DATABASE_SSL": "true",
    "VECTORIZE_CONCURRENCY": "1",
    "SCAN_VECTORIZE_CONCURRENCY": "1",
    "SYNC_INSERT_BATCH_SIZE": "50"
  }
}
